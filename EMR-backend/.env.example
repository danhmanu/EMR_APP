# Copy thành .env rồi điền giá trị thực — KHÔNG commit .env lên git
# cp .env.example .env

# MySQL
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_PASSWORD=changeme_user

# JWT — tối thiểu 32 ký tự
JWT_KEY=replace_with_a_secure_random_key_min_32_chars

# Số giờ token JWT có hiệu lực (mặc định 8)
JWT_EXPIRY_HOURS=8
